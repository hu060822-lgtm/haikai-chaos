; Engine configuration file.
config_version=5

[application]

config/name="HAIKAI: CHAOS"
config/description="Competitive movement shooter with free, unrealistic gun modding. Art: FAULTPRINT."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[input_devices]

buffering/agile_event_flushing=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[shader_globals]

fp_soft={
"type": "float",
"value": 1.0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
